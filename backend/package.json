{
  "name": "vite-express-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server/main.js -w src/server",
    "start": "NODE_ENV=production node src/server/main.js",
    "build": "prisma generate && find src/server -name '*.js' -exec node --check {} \\;",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "vite": "^6.3.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "vite-express": "*"
  }
}
